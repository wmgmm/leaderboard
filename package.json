{
  "name": "leaderboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run build && tsx watch server/index.ts",
    "build": "node scripts/build.mjs && npm run build:sprint",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "build:sprint": "npm --prefix sprint run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
